# Envoi des demandes de devis (https://resend.com). Sans clé, le formulaire
# fonctionne en développement (messages affichés dans la console) et renvoie
# vers le téléphone / WhatsApp en production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@maisonnette-traiteur.fr
CONTACT_FROM_EMAIL="Maisonnette Traiteur <site@maisonnette-traiteur.fr>"
